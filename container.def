Bootstrap: docker
From: pytorch/pytorch:2.9.0-cuda13.0-cudnn9-runtime

%environment
    export MUJOCO_GL=egl
    export PYOPENGL_PLATFORM=egl
    export NUMBA_CACHE_DIR=/tmp
    export PYTHONUNBUFFERED=1
    export PIP_NO_CACHE_DIR=1
    export TZ=Europe/London
    # With Apptainer --nv, put container libs first so its GLVND dispatch
    # is found before the host copies injected into /.singularity.d/libs/.
    # CUDA driver libs (libcuda.so, libnvidia-ml.so) only exist in the
    # injected dir, so they are still found as a fallback.
    export LD_LIBRARY_PATH=/usr/lib/x86_64-linux-gnu${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}


%post
    export DEBIAN_FRONTEND=noninteractive

    apt-get update && apt-get install -y \
        vim git \
        libegl1 libegl1-mesa libegl-mesa0 \
        libgl1-mesa-glx libgl1-mesa-dri libgl1-mesa-dev \
        libgles2 libosmesa6 libosmesa6-dev libglew-dev \
        wget unrar cmake g++ \
        libx11-6 libxext6 libxrender1 libxrender-dev libsm6 \
        libglib2.0-0 libgomp1 \
        libavcodec-dev libavformat-dev libavutil-dev libswscale-dev libavdevice-dev \
        openjdk-8-jdk x11-xserver-utils xvfb \
        && apt-get clean && rm -rf /var/lib/apt/lists/*

    pip install --upgrade pip
    pip uninstall -y cmake || true

    # ---------- Core scientific ----------
    pip install \
        numpy==1.26.4 \
        scipy==1.15.3 \
        h5py==3.15.1 \
        pillow==11.3.0 \
        numba==0.62.1

    # ---------- RL / simulation ----------
    # Optional extras kept disabled for this image:
    #   dm-control==1.0.9
    #   memory-maze==1.0.3
    #   crafter==1.8.0
    pip install \
        gym==0.22.0 \
        mujoco==3.3.7 \
        glfw==2.10.0 \
        egl_probe==1.0.2 \
        PyOpenGL==3.1.10

    # ---------- Video / image ----------
    pip install \
        opencv-python-headless==4.7.0.72 \
        moviepy==1.0.3 \
        imageio==2.37.0 \
        imageio-ffmpeg==0.6.0

    # ---------- Logging / visualization ----------
    pip install \
        matplotlib==3.5.0 \
        tensorboard==2.17.1 \
        tensorboardX==2.6.4 \
        wandb==0.22.2

    # ---------- Config / serialization ----------
    pip install \
        einops==0.3.0 \
        protobuf==3.20.0 \
        ruamel.yaml==0.17.4 \
        cloudpickle==3.1.2


    # ---------- Robotics ----------
    pip install \
        robosuite_models==1.0.0

    # ---------- robosuite & robomimic from source ----------
    pip install "robosuite @ git+https://github.com/ARISE-Initiative/robosuite.git@cb25aae7cac84c10409b96827a6c8d5a21f48f3a"
    pip install "robomimic @ git+https://github.com/ARISE-Initiative/robomimic.git@0ca7ce74cf8f20be32029657ef9320db033d93e9"

    # NVIDIA EGL vendor JSON for GLVND dispatch.
    # --nv injects libEGL_nvidia.so.0 into /.singularity.d/libs/ but does
    # NOT inject vendor JSON files. Without this, GLVND falls back to Mesa
    # EGL which requires /dev/dri access (usually denied on HPC clusters).
    mkdir -p /usr/share/glvnd/egl_vendor.d
    printf '{\n    "file_format_version" : "1.0.0",\n    "ICD" : {\n        "library_path" : "libEGL_nvidia.so.0"\n    }\n}\n' \
        > /usr/share/glvnd/egl_vendor.d/10_nvidia.json

%labels
    Author zhuoxuan-li
    Description DreamerV3-torch with RoboSuite/RoboMimic support
