# Build:
# docker build -f Dockerfile.container-test -t dreamerv3-container-test .
#
# Smoke test:
# docker run --rm -it --gpus all \
#   -v "$PWD:/workspace" \
#   -w /workspace \
#   dreamerv3-container-test \
#   python test_container.py

FROM pytorch/pytorch:2.9.0-cuda13.0-cudnn9-runtime

ARG DEBIAN_FRONTEND=noninteractive

ENV MUJOCO_GL=osmesa \
    NUMBA_CACHE_DIR=/tmp \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    TZ=Europe/London

RUN apt-get update && apt-get install -y \
    vim git \
    libegl1 libegl1-mesa libegl-mesa0 \
    libgl1-mesa-glx libgl1-mesa-dri libgl1-mesa-dev \
    libgles2 libosmesa6 libosmesa6-dev libglew-dev \
    wget unrar cmake g++ \
    libx11-6 libxext6 libxrender1 libxrender-dev libsm6 \
    libglib2.0-0 libgomp1 \
    libavcodec-dev libavformat-dev libavutil-dev libswscale-dev libavdevice-dev \
    openjdk-8-jdk x11-xserver-utils xvfb \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

RUN pip install --upgrade pip
RUN pip uninstall -y cmake || true

RUN pip install \
    numpy==1.26.4 \
    scipy==1.15.3 \
    h5py==3.15.1 \
    pillow==11.3.0 \
    numba==0.62.1

RUN pip install \
    gym==0.22.0 \
    mujoco==3.3.7 \
    glfw==2.10.0 \
    egl_probe==1.0.2 \
    PyOpenGL==3.1.10

RUN pip install \
    opencv-python-headless==4.7.0.72 \
    moviepy==1.0.3 \
    imageio==2.37.0 \
    imageio-ffmpeg==0.6.0

RUN pip install \
    matplotlib==3.5.0 \
    tensorboard==2.17.1 \
    tensorboardX==2.6.4 \
    wandb==0.22.2

RUN pip install \
    einops==0.3.0 \
    protobuf==3.20.0 \
    ruamel.yaml==0.17.4 \
    cloudpickle==3.1.2

RUN pip install robosuite_models==1.0.0
RUN pip install "robosuite @ git+https://github.com/ARISE-Initiative/robosuite.git@cb25aae7cac84c10409b96827a6c8d5a21f48f3a"
RUN pip install "robomimic @ git+https://github.com/ARISE-Initiative/robomimic.git@0ca7ce74cf8f20be32029657ef9320db033d93e9"

WORKDIR /workspace

CMD ["bash"]

LABEL org.opencontainers.image.authors="zhuoxuan-li" \
      org.opencontainers.image.description="DreamerV3-torch container test image mirroring container.def"
